[PHP]

;;;;;;;;;;;;;;;;;;;
; 基本設定（本番環境向け）
;;;;;;;;;;;;;;;;;;;

; エラー報告レベル（Deprecated/Noticeは記録するが表示はしない）
error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT

; 画面へのエラー表示は無効化（ユーザーに内部情報を漏らさない）
display_errors = Off
display_startup_errors = Off

; エラーログをコンテナの標準エラー出力へ記録する
log_errors = On
error_log = /dev/stderr

; PHPバージョン等の露出を防ぐ
expose_php = Off

; スクリプトの最大実行時間（秒）
max_execution_time = 60

; スクリプトの最大メモリ使用量
memory_limit = 256M

; POSTデータの最大サイズ（アップロード含む）
post_max_size = 32M

; ファイルアップロードの許可・最大サイズ・最大数
file_uploads = On
upload_max_filesize = 32M
max_file_uploads = 20

; 一度に受け付ける入力変数の最大数（フォーム項目が多い場合の対策）
max_input_vars = 5000

; タイムゾーン
date.timezone = Asia/Tokyo

; 出力バッファリング
output_buffering = 4096

; マルチバイト文字列関連
[mbstring]
mbstring.language = Japanese
mbstring.internal_encoding = UTF-8

;;;;;;;;;;;;;;;;;;;
; セッション設定
;;;;;;;;;;;;;;;;;;;

[Session]
session.cookie_httponly = On
session.use_strict_mode = On
session.cookie_samesite = Lax
; HTTPS配信を前提に、セッションクッキーはSecure属性のみで送信する
session.cookie_secure = On

;;;;;;;;;;;;;;;;;;;
; OPcache設定（本番環境：最大限キャッシュし再検証しない）
;;;;;;;;;;;;;;;;;;;

[opcache]
opcache.enable = 1
opcache.memory_consumption = 256
opcache.interned_strings_buffer = 32
opcache.max_accelerated_files = 20000
; デプロイ時に確実に反映するため、ソース変更の自動検知は無効化する
; （リリース時は必ず opcache_reset または再起動を行うこと）
opcache.validate_timestamps = 0
opcache.save_comments = 1
opcache.enable_cli = 0

;;;;;;;;;;;;;;;;;;;
; Zendリソース制限
;;;;;;;;;;;;;;;;;;;

[Zend]
realpath_cache_size = 4096K
realpath_cache_ttl = 600
